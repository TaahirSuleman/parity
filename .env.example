# Copy to .env (git-ignored). Never commit, print or read the real key aloud.
MODEL_API_KEY=REPLACE_ME
META_API_BASE=https://api.meta.ai/v1

# Models: every runtime model is a Meta model. Prices live in parity/meta/pricing.py.
# Roles per docs/19-design-spec.md section 6.1.
PARITY_MODEL=muse-spark-1.3-contributor
PARITY_JUDGE_FALLBACK_MODEL=muse-spark-1.3   # tried once if the judge model errors (D6)
PARITY_JUDGE_MODEL=muse-spark-1.3
PARITY_EVAL_MODEL=muse-spark-1.3-contributor
PARITY_VOICE_MODEL=muse-voice-transcribe-1.0
# true = standard muse-spark-1.3 for every Spark stage (data not used for training)
PARITY_PRIVATE=false

# Storage: run bundles (JSON + PNG) are the truth; the SQLite index is a derived cache.
# Local: bundles under PARITY_DATA_DIR. Cloud Run: set PARITY_GCS_BUCKET instead.
PARITY_DATA_DIR=./data
PARITY_GCS_BUCKET=
PARITY_INDEX_PATH=./data/index.db
PARITY_CACHE_DIR=./cache
PARITY_REPLAY_DIR=./fixtures/replay

# Serving
PORT=8080
PARITY_DEFAULT_MODE=replay
PARITY_LIVE_ENABLED=true
PARITY_LIVE_PER_IP_PER_HOUR=3
# URL-policy lookups (DNS and robots.txt) one visitor may cause an hour on the "page you choose" field; a refused address costs a lookup, never a run
PARITY_URL_LOOKUPS_PER_IP_PER_HOUR=20
PARITY_LIVE_GLOBAL_PER_DAY=40
# "self" = Live runs may only target the bundled demo store. A comma-separated list of origins otherwise.
PARITY_LIVE_TARGET_ORIGINS=self
# The W3C BAD pages as read-only flows a judge can run (docs/19 section 19.2); 0 hides the group.
PARITY_EXTERNAL_FLOWS=1

# "Live on a page you choose" (docs/19 section 19.3): a visitor's public URL, audited read-only, no fixes.
# Default: on when MODEL_API_KEY is set. 0 is the kill switch (the field disappears, the route answers 403).
PARITY_OPEN_URL=
# Hosts that asked not to be audited (their subdomains too), comma-separated.
PARITY_URL_DENY=
# The opt-out and takedown contact shown on /audit-policy (default: the repository author's address).
PARITY_CONTACT_EMAIL=
# Pages known to run well, offered under the field, comma-separated.
PARITY_SUGGESTED_URLS=
# Caps on top of the Live limits above: per run (ends cleanly at the cap), per day for everyone, per origin per day, seconds per screen.
PARITY_EXTERNAL_RUN_USD=0.50
PARITY_EXTERNAL_DAILY_USD=5
PARITY_EXTERNAL_PER_ORIGIN_PER_DAY=3
PARITY_EXTERNAL_TIMEOUT_S=300
LOG_LEVEL=info
# 1 only while recording store/voice/*.wav locally (docs/voice-recording.md): the focus-log endpoint never exists on the hosted app
PARITY_VOICE_FOCUSLOG=0
# the recorded VoiceOver clips and their sidecars (spec §16; default store/voice in the source tree)
PARITY_VOICE_DIR=./store/voice
