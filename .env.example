# Copy to .env (git-ignored). Never commit, print or read the real key aloud.
MODEL_API_KEY=REPLACE_ME
META_API_BASE=https://api.meta.ai/v1

# Models: every runtime model is a Meta model. Prices live in parity/meta/pricing.py.
# Roles per docs/19-design-spec.md section 6.1.
PARITY_MODEL=muse-spark-1.3-contributor
PARITY_JUDGE_MODEL=muse-spark-1.3
PARITY_EVAL_MODEL=muse-spark-1.3-contributor
PARITY_VOICE_MODEL=muse-voice-transcribe-1.0
# true = standard muse-spark-1.3 for every Spark stage (data not used for training)
PARITY_PRIVATE=false

# Storage: run bundles (JSON + PNG) are the truth; the SQLite index is a derived cache.
# Local: bundles under PARITY_DATA_DIR. Cloud Run: set PARITY_GCS_BUCKET instead.
PARITY_DATA_DIR=./data
PARITY_GCS_BUCKET=
PARITY_INDEX_PATH=./data/index.db
PARITY_CACHE_DIR=./cache
PARITY_REPLAY_DIR=./fixtures/replay

# Serving
PORT=8080
PARITY_DEFAULT_MODE=replay
PARITY_LIVE_ENABLED=true
PARITY_LIVE_PER_IP_PER_HOUR=3
PARITY_LIVE_GLOBAL_PER_DAY=40
# "self" = Live runs may only target the bundled demo store. A comma-separated list of origins otherwise.
PARITY_LIVE_TARGET_ORIGINS=self
LOG_LEVEL=info
